# DashScope LLM (Required)
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL
PG_URL=jdbc:postgresql://localhost:5432/interview_agent
PG_USERNAME=interview
PG_PASSWORD=interview

# JWT
JWT_SECRET=interview-agent-default-secret

# GitHub (Optional)
GITHUB_TOKEN=

# Auth
AUTH_ENABLED=true

# ML 服务（ml/，可选）：简历解析 + QLoRA 微调评分模型
ML_SERVICE_URL=
ML_RESUME_PARSER_ENABLED=true
ML_SCORER_ENABLED=false
